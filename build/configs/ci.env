# Build settings used by .github/workflows/build.yml.
# No secrets here: GitHub secrets are injected at runtime, never versioned.

# Image size for CI artefacts. Kept small on purpose: CI does not embed the
# Switchroot payloads, so a large image only wastes runner minutes.
CI_IMAGE_SIZE=8G

# Rootfs artefact retention (days). The rootfs is ~1 GiB uncompressed.
CI_ARTIFACT_RETENTION=7

# Timeout for the ARM64 bootstrap job, in minutes.
CI_BOOTSTRAP_TIMEOUT=45

# Shell used for `bash -n` and validation; must be bash 5+ (ubuntu-latest).
CI_BASH=/usr/bin/env bash

# shellcheck version expected by the validation job (Ubuntu package).
CI_SHELLCHECK_MIN=0.9.0
